<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="urn:ualg:calculator"
  name="CalculatorService"
  targetNamespace="urn:ualg:calculator">

  <wsdl:types>
    <xsd:schema targetNamespace="urn:ualg:calculator" elementFormDefault="qualified">
      <xsd:complexType name="Operands">
        <xsd:sequence>
          <xsd:element name="a" type="xsd:double"/>
          <xsd:element name="b" type="xsd:double"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="CalculationResult">
        <xsd:sequence>
          <xsd:element name="result" type="xsd:double"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="add" type="tns:Operands"/>
      <xsd:element name="addResponse" type="tns:CalculationResult"/>
      <xsd:element name="subtract" type="tns:Operands"/>
      <xsd:element name="subtractResponse" type="tns:CalculationResult"/>
      <xsd:element name="multiply" type="tns:Operands"/>
      <xsd:element name="multiplyResponse" type="tns:CalculationResult"/>
      <xsd:element name="divide" type="tns:Operands"/>
      <xsd:element name="divideResponse" type="tns:CalculationResult"/>
    </xsd:schema>
  </wsdl:types>


  <wsdl:message name="AddRequest">
    <wsdl:part name="parameters" element="tns:add"/>
  </wsdl:message>
  <wsdl:message name="AddResponse">
    <wsdl:part name="parameters" element="tns:addResponse"/>
  </wsdl:message>
  <wsdl:message name="SubtractRequest">
    <wsdl:part name="parameters" element="tns:subtract"/>
  </wsdl:message>
  <wsdl:message name="SubtractResponse">
    <wsdl:part name="parameters" element="tns:subtractResponse"/>
  </wsdl:message>
  <wsdl:message name="MultiplyRequest">
    <wsdl:part name="parameters" element="tns:multiply"/>
  </wsdl:message>
  <wsdl:message name="MultiplyResponse">
    <wsdl:part name="parameters" element="tns:multiplyResponse"/>
  </wsdl:message>
  <wsdl:message name="DivideRequest">
    <wsdl:part name="parameters" element="tns:divide"/>
  </wsdl:message>
  <wsdl:message name="DivideResponse">
    <wsdl:part name="parameters" element="tns:divideResponse"/>
  </wsdl:message>

  
  <wsdl:portType name="CalculatorPortType">
    <wsdl:operation name="add">
      <wsdl:input message="tns:AddRequest"/>
      <wsdl:output message="tns:AddResponse"/>
    </wsdl:operation>
    <wsdl:operation name="subtract">
      <wsdl:input message="tns:SubtractRequest"/>
      <wsdl:output message="tns:SubtractResponse"/>
    </wsdl:operation>
    <wsdl:operation name="multiply">
      <wsdl:input message="tns:MultiplyRequest"/>
      <wsdl:output message="tns:MultiplyResponse"/>
    </wsdl:operation>
    <wsdl:operation name="divide">
      <wsdl:input message="tns:DivideRequest"/>
      <wsdl:output message="tns:DivideResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="CalculatorBinding" type="tns:CalculatorPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="add">
      <soap:operation soapAction="urn:ualg:calculator/add"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="subtract">
      <soap:operation soapAction="urn:ualg:calculator/subtract"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="multiply">
      <soap:operation soapAction="urn:ualg:calculator/multiply"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="divide">
      <soap:operation soapAction="urn:ualg:calculator/divide"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="CalculatorService">
    <wsdl:port name="CalculatorPort" binding="tns:CalculatorBinding">
      <soap:address location="http://localhost:8000/calculator"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
